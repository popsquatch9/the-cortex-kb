# Cortex Knowledge Base Configuration

# Data storage directory
DATA_DIR=./cortex_data

# External source fetching
ENABLE_WEB_SEARCH=true
MAX_EXTERNAL_SOURCES=5

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Quality threshold (0.0 - 1.0)
RELEVANCE_THRESHOLD=0.7

# LLM Provider Configuration
# Choose: 'claude', 'gemini', or 'none' (default: none)
LLM_PROVIDER=none

# Anthropic Claude API (if using Claude)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: Specify Claude model (default: claude-3-5-sonnet-20241022)
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Gemini API (if using Gemini)  
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Optional: Specify Gemini model (default: gemini-pro)
# GEMINI_MODEL=gemini-pro

# LLM Features
# Enable LLM-powered summarization
LLM_SUMMARIZATION=true
# Enable LLM-powered categorization
LLM_CATEGORIZATION=true
# Enable LLM-powered concept extraction
LLM_CONCEPT_EXTRACTION=true
